{
  "name": "mediabritesmile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "images": "node scripts/optimize-images.mjs",
    "predev": "node scripts/optimize-images.mjs",
    "dev": "node node_modules/next/dist/bin/next dev",
    "prebuild": "node scripts/optimize-images.mjs",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.72.0",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "nodemailer": "10.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
