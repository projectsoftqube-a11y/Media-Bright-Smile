# Email (SMTP) for the appointment request forms (/patient-information/scheduling and /contact-us).
# Copy this file to .env.local for local testing, and add the same variables in Vercel
# (Project > Settings > Environment Variables) for the live site. Never commit real values.
#
# Until SMTP_HOST, SMTP_USER, SMTP_PASS, MAIL_FROM and MAIL_TO are all set, the forms still validate
# but tell visitors that online requests are not switched on yet and to call the practice.
#
# HIPAA: appointment requests contain protected health information (a name with a reason for visit).
# Use an email account whose provider has signed a Business Associate Agreement (BAA) with the
# practice, e.g. Google Workspace or Microsoft 365 with a BAA in place, or a HIPAA email service.
# The connection is always encrypted (STARTTLS on 587, or TLS on 465).

# SMTP server. Google Workspace: smtp.gmail.com | Microsoft 365: smtp.office365.com
SMTP_HOST=
# 587 (STARTTLS, recommended) or 465 (TLS from the start)
SMTP_PORT=587
# Optional: "true" forces TLS-from-the-start; by default it is on for port 465 only
SMTP_SECURE=
# Mailbox login. For Google Workspace use an App Password, not the normal account password.
SMTP_USER=
SMTP_PASS=

# Sender shown on the email. Must be an address the SMTP account is allowed to send as.
MAIL_FROM="Media Brite Smile Website <website@mediabritesmile.com>"
# Who receives the requests. Separate several addresses with commas.
MAIL_TO=
